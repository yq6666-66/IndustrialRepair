<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IndustrialRepair.DAL\IndustrialRepair.DAL.csproj" />
  </ItemGroup>

  <!-- 迁移脚本嵌入程序集：DbInitializer 优先读嵌入资源，发布包缺 db 目录也能建库
       （LogicalName 显式固定，规避 SDK 对 ..\ 外链文件自动命名的下划线转义）。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\01_init.sql" LogicalName="db.01_init.sql" />
    <EmbeddedResource Include="..\..\db\02_procs.sql" LogicalName="db.02_procs.sql" />
    <EmbeddedResource Include="..\..\db\04_material_review_migration.sql" LogicalName="db.04_material_review_migration.sql" />
    <EmbeddedResource Include="..\..\db\05_performance_indexes.sql" LogicalName="db.05_performance_indexes.sql" />
    <EmbeddedResource Include="..\..\db\06_new_features.sql" LogicalName="db.06_new_features.sql" />
    <EmbeddedResource Include="..\..\db\07_pm_order_link.sql" LogicalName="db.07_pm_order_link.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
  </ItemGroup>

  <PropertyGroup>
    <!-- BLL 使用 System.Drawing / SerialPort / OpenCV 等 Windows 专属 API（本系统仅面向 Windows） -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- System.Drawing.Common 10.x 在 net8.0 上的过时提示（仅面向 Windows 桌面场景，按需屏蔽） -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

</Project>
