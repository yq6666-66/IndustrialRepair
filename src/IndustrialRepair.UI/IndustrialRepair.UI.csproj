<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IndustrialRepair.BLL\IndustrialRepair.BLL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
    <PackageReference Include="SunnyUI" Version="3.9.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\db\01_init.sql" Link="db\01_init.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\02_procs.sql" Link="db\02_procs.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\04_material_review_migration.sql" Link="db\04_material_review_migration.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\05_performance_indexes.sql" Link="db\05_performance_indexes.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\06_new_features.sql" Link="db\06_new_features.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\07_pm_order_link.sql" Link="db\07_pm_order_link.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 全部界面按 96DPI 固定坐标设计（SunnyUI/UILoginForm 亦然），高缩放屏
         由系统整窗等比拉伸（DpiUnawareGdiScaled 文字更清晰）。
         默认 SystemAware 会让字体随 DPI 放大而盒子不变 → 150% 屏文字溢出重叠 -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>